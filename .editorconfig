# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
indent_style = space
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ps1,psm1,psd1}]
charset = utf-8-bom
indent_size = 4
tab_width = 4

[*.json]
indent_size = 2
tab_width = 2
